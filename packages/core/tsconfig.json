{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Relative imports carry the .ts extension so the same source runs in Deno (Edge Functions).
    "allowImportingTsExtensions": true,
    // No ambient Node or DOM types: core stays runtime-agnostic.
    "types": []
  },
  "include": ["src", "test"]
}
